# practice-api — local settings (copy to .env and adjust; never commit .env)
# Every variable is optional; defaults are optimised for local development
# with the built-in SQLite driver (no Docker required).

# --- Database driver --------------------------------------------------------
# sqlite : driver-agnostic SQLite via better-sqlite3 (default, local dev/test)
# mysql  : MySQL 8 via mysql2 (prod/compose); requires DB_URL
DB_DRIVER=sqlite

# --- MySQL connection (only required when DB_DRIVER=mysql) -------------------
# Never commit real credentials; this file must stay placeholder-only.
DB_URL=mysql://user:pass@localhost:3306/emma_practice

# --- SQLite file path (only used when DB_DRIVER=sqlite) ----------------------
# Tests override this with :memory: or a temporary file.
SQLITE_PATH=./data/practice.db

# --- HTTP service ------------------------------------------------------------
PORT=3000
APP_ENV=development

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=https://emma-murex-nine.vercel.app,http://localhost:3000,http://localhost:5173
