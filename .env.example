# EMMA voice gateway — Day 2 settings (copy to .env and adjust; never commit .env)
# Every variable is optional; defaults match local simulation development.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Provider mode --------------------------------------------------------
# simulation : local simulator flow (no Exotel account required)
# live       : Exotel AgentStream protocol; requires EXOTEL_API_KEY + EXOTEL_API_TOKEN
EXOTEL_MODE=simulation
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# --- Local WebSocket authentication ----------------------------------------
# Unset → open local development (readiness reports this explicitly).
WS_AUTH_TOKEN=

# --- WebSocket hardening (our Day-2 policy, all optional) -------------------
# MAX_WS_MESSAGE_BYTES=262144
# MAX_CONSECUTIVE_ERRORS=5
# MAX_CONCURRENT_SESSIONS=200
# EXOTEL_MAX_CHUNK_BYTES=100000
