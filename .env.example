# EMMA Voice & Medical Management Assistant — Environment Configuration
# Copy this file to .env and adjust values for your environment.

# --- Core Service & Deployment URLs ----------------------------------------
# Frontend URL (Vercel deployment):
FRONTEND_URL=https://emma-murex-nine.vercel.app

# Backend Voice Gateway URLs (Render deployment):
BACKEND_URL=https://emma-enhanced-medical-management.onrender.com
NEXT_PUBLIC_VOICE_GATEWAY_URL=ws://emma.heyompatil.me/ws/exotel

# Allowed CORS origins for backend (comma-separated or *):
CORS_ORIGINS=https://emma-murex-nine.vercel.app,http://localhost:3000,*

# --- Server Settings -------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Provider mode --------------------------------------------------------
# simulation : local simulator flow (no Exotel account required)
# live       : Exotel AgentStream protocol; requires EXOTEL_API_KEY + EXOTEL_API_TOKEN
EXOTEL_MODE=simulation
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# --- Local WebSocket authentication ----------------------------------------
# Unset → open local development (readiness reports this explicitly).
WS_AUTH_TOKEN=

# --- WebSocket hardening (our Day-2 policy, all optional) -------------------
# MAX_WS_MESSAGE_BYTES=262144
# MAX_CONSECUTIVE_ERRORS=5
# MAX_CONCURRENT_SESSIONS=200
# EXOTEL_MAX_CHUNK_BYTES=100000

# --- Day 3 — voice pipeline / speech providers --------------------------------
# Pipeline: echo (Day-2 byte-for-byte echo) | speech (STT → FSM → response → TTS).
VOICE_PIPELINE=speech
# Provider: mock | azure. Azure selected without key/region degrades readiness
# (never silently falls back to mock).
STT_PROVIDER=mock
TTS_PROVIDER=mock
VOICE_TRANSPORT=livekit
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_LANGUAGE=en-GB
AZURE_SPEECH_VOICE=en-GB-SoniaNeural

# Speech runtime timeouts (seconds).
SPEECH_CONNECTION_TIMEOUT=10
SPEECH_REQUEST_TIMEOUT=15

# Mock STT determinism (all optional; see apps/voice-gateway docs).
# MOCK_STT_SCRIPT=I would like to book an appointment,|please respond with a test response,|I need to move my appointment,|I need a prescription repeat
# MOCK_STT_FINALIZE_MS=250
# MOCK_STT_UTTERANCE_MS=1000
# MOCK_STT_ERROR_AT_FRAME=0

# --- Day 3 — practice backend (NestJS; optional) ------------------------------
# Unset/empty → voice gateway runs without persistence (speech continues without it).
# PRACTICE_API_BASE_URL=http://localhost:3000
# PRACTICE_API_TIMEOUT=5
# PRACTICE_API_MAX_ATTEMPTS=2
# PRACTICE_ID=

# --- Day 5 — LLM conversation engine -------------------------------------------
# Provider: mock | azure | gemini. mock is the safe local default; a real
# provider without credentials fails clearly (never silently falls back).
LLM_PROVIDER=mock
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=800
LLM_PROMPT_VERSION=v1

# --- Day 12/13 — LiveKit WebRTC voice runtime (optional) --------------------
# Only required when VOICE_TRANSPORT=livekit. Credentials never reach the
# browser; tokens are minted server-side with short expiry.
#
# Local development (self-hosted LiveKit server):
#   LIVEKIT_URL=ws://127.0.0.1:7880
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=secret
#
# Production: replace with your LiveKit server URL and real credentials.
# Never use development credentials in production.
# LIVEKIT_URL=wss://your-livekit-server.example.com
# LIVEKIT_API_KEY=your-production-key
# LIVEKIT_API_SECRET=your-production-secret

# --- Day 12 — speech providers --------------------------------------------
# Deepgram Flux (Day 12 primary STT; see docs/runbooks/deepgram-flux-setup.md).
# Set DEEPGRAM_API_KEY in your ignored .env only — never record it here.
# DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux-general-en

# OpenAI LLM (Day 12 primary LLM; see docs/runbooks/openai-gpt6-luna-setup.md).
# Set OPENAI_API_KEY in your ignored .env only — never record it here.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# ElevenLabs TTS (Day 12 primary TTS; see docs/runbooks/elevenlabs-setup.md).
# Set ELEVENLABS_API_KEY and ELEVENLABS_VOICE_ID in your ignored .env only.
# ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=

# Day 12 OpenAI budget guard (assignment §2).
OPENAI_DAILY_BUDGET_USD=2.50
OPENAI_DEV_BUDGET_USD=1.00
OPENAI_INPUT_USD_PER_1K_TOKENS=0.005
OPENAI_OUTPUT_USD_PER_1K_TOKENS=0.015
OPENAI_CACHED_USD_PER_1K_TOKENS=0.00125
