# EMMA UI — Environment Configuration
# Next.js reads NEXT_PUBLIC_* variables in the browser.

# Backend Voice Gateway WebSocket URL:
# For production (Render):
NEXT_PUBLIC_VOICE_GATEWAY_URL=wss://emma-enhanced-medical-management.onrender.com/ws/exotel

# For local development:
# NEXT_PUBLIC_VOICE_GATEWAY_URL=ws://localhost:8000/ws/exotel

